+}
+
+.dot { width: 6px; height: 6px; border-radius: 50%; }
+.dotTech { background: var(--neon2); box-shadow: 0 0 8px var(--neon2); }
+.dotPersonal { background: var(--amber); box-shadow: 0 0 8px var(--amber); }
