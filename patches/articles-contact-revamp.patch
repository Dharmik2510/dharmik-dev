+.metaDot { color: var(--border2); }
+.read { margin-left: auto; color: var(--neon); font-weight: 700; }
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 12px;
+}
+
+.empty {
+  font-family: var(--mono);
+  font-size: 12px;
+  letter-spacing: .1em;
+  color: var(--muted);
+  text-align: center;
+  padding: 40px 20px;
+  border: 1px dashed var(--border);
+}
+
+.moreWrap {
+  display: flex;
+  justify-content: center;
+  padding-top: 8px;
+}
+
+.moreBtn {
+  display: inline-flex;
+  align-items: center;
+  gap: 16px;
+  padding: 14px 28px;
+  background: transparent;
+  border: 1px solid var(--border2);
+  border-radius: 2px;
+  font-family: var(--mono);
+  font-size: 11px;
+  letter-spacing: .14em;
+  text-transform: uppercase;
+  color: var(--text);
+  cursor: pointer;
+  transition: border-color .2s, color .2s, background .2s;
+  font-weight: 700;
+}
+
+.moreBtn:hover {
+  border-color: var(--neon);
+  color: var(--neon);
+  background: rgba(0, 229, 255, .06);
+}
+
+.moreCount {
+  color: var(--muted);
+  font-weight: 400;
+}
+
+@media (max-width: 1100px) {
+  .grid { grid-template-columns: repeat(2, 1fr); }
+}
+
+@media (max-width: 768px) {
+  .toolbar {
+    flex-direction: column;
+    align-items: stretch;
+    padding: 14px 16px;
+  }
+
+  .filters { justify-content: center; }
+
+  .grid { grid-template-columns: 1fr; }
+
+  .cardFeatured { padding: 24px 22px; }
+
+  .cardFeatured .title { font-size: 20px; }
+
+  .read { margin-left: 0; width: 100%; margin-top: 4px; }
+}
+
+@media (max-width: 480px) {
+  .stats { font-size: 10px; gap: 8px; }
+  .filterBtn { padding: 7px 10px; font-size: 9px; }
+  .card { padding: 18px 16px; }
+}
